# VoiceGuard Environment Configuration Template
# Copy to .env and populate with secure credentials

# 32-byte base64 AES-256 enrollment key (generate via: uv run python scripts/enroll.py --gen-key)
VOICEGUARD_ENROLLMENT_KEY=YOUR_BASE64_32_BYTE_ENROLLMENT_KEY_HERE

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_32_hex_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public URL for Webhooks (e.g. ngrok or cloudflared tunnel)
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Server settings
PORT=8000
HOST=0.0.0.0
