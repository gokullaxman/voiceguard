# VoiceGuard Environment Configuration Example
# Copy to .env and populate with your real secrets.
# NEVER commit .env to source control.

# Twilio Credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Public Server Tunnel / Host for Webhooks
VOICEGUARD_HOST=your-ngrok-or-localtunnel-subdomain.ngrok-free.app

# Voiceprint Encryption Key (32-byte base64 encoded for AES-256-GCM)
VOICEPRINT_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZW5jcnlwdGlvbi1rZXk=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
